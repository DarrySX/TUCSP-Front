# Supabase - Obtener desde: https://supabase.com/dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_aqui

# Supabase Service Role Key (PRIVADA - nunca exponer al cliente)
# Obtener desde: Supabase → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# Secreto para el endpoint de creación de superusuario
# Usar un valor seguro en producción
SETUP_SECRET=dev-setup-secret

# Resend — API key para envío de correos desde el formulario de contacto
# Obtener desde: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
